# Copia este archivo a backend/.env y completa los valores.
# El .env real NUNCA se sube al repositorio.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Genera una llave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-llave-antes-de-desplegar
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Con docker compose el host es "db"; corriendo Django a mano es "localhost".
DATABASE_URL=postgres://carneseus:carneseus@localhost:5433/carneseus

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Reglas de negocio
# ---------------------------------------------------------------------------
COSTO_DOMICILIO=8000
ZONAS_COBERTURA=Medellin,Envigado,Itagui,Sabaneta,Bello,La Estrella

# ---------------------------------------------------------------------------
# Wompi (pasarela de pagos)
# ---------------------------------------------------------------------------
# Las cuatro llaves salen de comercios.wompi.co, en "Mi cuenta".
# En sandbox tienen los prefijos que se muestran abajo; en produccion son
# pub_prod_, prv_prod_, prod_events_ y prod_integrity_.
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_
WOMPI_PRIVATE_KEY=prv_test_
WOMPI_EVENTS_SECRET=test_events_
WOMPI_INTEGRITY_SECRET=test_integrity_
