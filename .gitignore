# ---- Secretos ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ---- Django ----
db.sqlite3
/backend/media/
/backend/staticfiles/

# ---- Node / Angular ----
node_modules/
/frontend/dist/
/frontend/.angular/
npm-debug.log*

# ---- Editores / SO ----
# Solo la .vscode de la raiz; cada subproyecto decide en su propio .gitignore.
# Se excluye el CONTENIDO y no la carpeta: git no permite reincluir un archivo
# si su carpeta entera esta excluida. settings.json si viaja: ahi esta el ajuste
# que obliga al editor a usar el TypeScript del proyecto.
/.vscode/*
!/.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Wiki ----
# Es un clon del repositorio de wiki que GitHub aloja aparte
# (CarnesEUS-MVP.wiki.git). Anidarlo aqui subiria una referencia rota.
/wiki/
